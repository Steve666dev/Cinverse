# Server-side Environment Variables for IMDb AWS Data Exchange & OMDb Proxy
# Keep secrets on backend only - NEVER prefix with VITE_

PORT=3001
AWS_REGION=us-east-1

# AWS SigV4 Credentials (IAM user with AWSDataExchangeSubscriberFullAccess)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_SESSION_TOKEN=optional_session_token_if_using_sts

# IMDb Subscription IDs on AWS Data Exchange
IMDB_DATA_SET_ID=your_imdb_data_set_id
IMDB_REVISION_ID=your_imdb_revision_id
IMDB_ASSET_ID=your_imdb_asset_id
IMDB_X_API_KEY=your_imdb_x_api_key

# OMDb API Key (Fallback for missing director/actors/poster/ratings)
OMDB_API_KEY=your_omdb_api_key_here


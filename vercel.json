{
  "functions": {
    "api/*.js": {
      "includeFiles": "{data,public}/cache/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/data/(.*)",
      "destination": "/data/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
